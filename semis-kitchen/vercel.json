{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/invoice/:orderId",
      "destination": "https://api.semiskitchen.in/api/invoices/share/:orderId"
    },
    {
      "source": "/api/:path*",
      "destination": "https://api.semiskitchen.in/api/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
