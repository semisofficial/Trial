# PostgreSQL connection string. For Neon, use the "Pooled connection" string
# from your Neon dashboard. Add it only to the backend service, e.g.:
# The pooled hostname contains "-pooler". Do not use Neon's direct endpoint
# for the Vercel or Render deployment. Inactivity is handled by pg's 30-second
# idle-client timeout; DB_INACTIVITY_TIMEOUT_MS is intentionally not needed.
# verify-full documents the intended certificate and hostname verification.
# The application also enforces this explicitly for remote connections.
# postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=verify-full
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=verify-full

# Port for local dev (Vercel and Render provide this automatically)
PORT=5000

# Comma-separated list of allowed CORS origins.
# For production, put your deployed frontend domain here, e.g.:
# https://semiskitchen.in,https://www.semiskitchen.in
# For local dev keep http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# --- Admin authentication ---
# Set both values in the backend Vercel project only. Never expose them as
# VITE_* variables or commit real values. SESSION_SECRET must be at least 32
# random characters (generate a unique value with a password manager).
ADMIN_PASSWORD=replace-with-a-strong-admin-password
SESSION_SECRET=replace-with-at-least-32-random-characters

# --- Google Sheets sync (see SETUP.md for how to obtain these) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nMIIEv...\\n-----END PRIVATE KEY-----\\n"
GOOGLE_SHEET_ID=1a2B3cD4EfGhIjKlMnOpQrStUvWxYz_exampleOnly

# --- WhatsApp Business API (order notifications) ---
# Phone Number ID: https://developers.facebook.com/apps -> your app -> WhatsApp
# -> API Setup. The app sends customer order notifications to WhatsApp.
WHATSAPP_PHONE_NUMBER_ID=
# Token: Meta's API Setup page, "Generate token" button. Use a PERMANENT
# token for production — the one shown first expires after 24h.
WHATSAPP_PERMANENT_TOKEN=
# Keep false until the client's Meta account and templates are ready.
WHATSAPP_NOTIFICATIONS_ENABLED=false
# Public customer-site base URL. Its /api rewrite reaches the backend while
# keeping invoice links under semiskitchen.in.
PUBLIC_API_BASE_URL=https://semiskitchen.in

# Canonical customer-facing site used in invoice metadata and share links.
PUBLIC_SITE_URL=https://semiskitchen.in

# --- Resend email (admin new-order notifications) ---
# API key from https://resend.com/api-keys (never commit the real value)
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXX
# All three values are required; notifications are skipped if any is missing.
# Sender must be an address on a domain verified in the client's Resend account.
RESEND_FROM=orders@semiskitchen.in
# Recipient must be an inbox controlled by the restaurant.
ADMIN_EMAIL=orders@semiskitchen.in
